;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	nico.turinghelpdesk.local. root.turinghelpdesk.local. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
	IN	NS	nico.turinghelpdesk.local.
1	IN	PTR	nico.turinghelpdesk.local.
@	IN	AAAA	::1
